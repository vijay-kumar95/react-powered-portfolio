pipeline 
{
    agent any

    environment {
        IMAGE_NAME = "my-app"                         
        IMAGE_TAG  = "${BUILD_NUMBER}" 
        CONTAINER_NAME = 'app-container' 
        AWS_REGION = 'ap-south-1' 
        INSTANCE_ID = 'i-0dea03ce5a9e7fdb4'  
        NEXUS_URL="3.111.38.13:80"            
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'custom', url: 'https://github.com/vijay-kumar95/react-powered-portfolio.git'
                // Fetch code from GitHub
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                //sh 'npm ci --cache .npm-cache'
            }
        }
        
        stage('Unit Tests') {
            steps {
                sh 'npm test || true'
                // Run tests (temporary: do not fail pipeline)
            }
        }

        stage('SonarQube Analysis') {
              steps {
                   withSonarQubeEnv('sonarqube-server') {
                    sh '''
                     sonar-scanner \
                    -Dsonar.projectKey=portfolio-app \
                    -Dsonar.sources=src \
                    -Dsonar.host.url=$SONAR_HOST_URL \
                    -Dsonar.login=$SONAR_AUTH_TOKEN \
                    -Dsonar.exclusions=node_modules/**,dist/** \
                    -Dsonar.ws.timeout=30
                '''
                }
            }
        }

        stage('Quality Gate') {
                steps {
                      timeout(time: 2, unit: 'MINUTES') {
                          waitForQualityGate abortPipeline: true 
                       }
                 }
        }
    

        stage('Build Application') {
            steps {
                sh 'npm run build'
                // Build production bundle
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                """
                // Create Docker image
            }
        }

        stage('Push Docker Image to Nexus') 
        {
            steps {
                  withCredentials([usernamePassword(
                  credentialsId: 'nexus-npm-cred',   // ensure this is Nexus creds
                  usernameVariable: 'USER',
                  passwordVariable: 'PASS'
                  )]) {
                    sh '''
                      set -e

                          echo "Verifying local image exists..."
                          docker images | grep "${IMAGE_NAME}" || { echo "Image not found"; exit 1; }

                          echo "Tagging image for Nexus..."
                          docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${NEXUS_URL}/${IMAGE_NAME}:${IMAGE_TAG}

                          echo "Logging into Nexus..."
                          echo "$PASS" | docker login ${NEXUS_URL} -u "$USER" --password-stdin

                          echo "Pushing image..."
                          docker push ${NEXUS_URL}/${IMAGE_NAME}:${IMAGE_TAG}
                       '''
                   }   
            }
        }

        stage('Deploy via SSM') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-npm-cred',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    sh '''
                    set -e
        
                    IMAGE="${NEXUS_URL}/${IMAGE_NAME}:${IMAGE_TAG}"
        
                    echo "🚀 Deploying IMAGE=$IMAGE to EC2 via SSM..."
        
                    aws ssm send-command \
                      --region ${AWS_REGION} \
                      --instance-ids "${INSTANCE_ID}" \
                      --document-name "AWS-RunShellScript" \
                      --comment "Deploying Docker image from Jenkins" \
                      --parameters commands="[
                        \\"set -x\\",
        
                        \\"echo Logging into Nexus...\\",
                        \\"echo '${NEXUS_PASS}' | docker login ${NEXUS_URL} -u '${NEXUS_USER}' --password-stdin\\",
        
                        \\"echo Pulling image...\\",
                        \\"docker pull ${IMAGE}\\",
        
                        \\"echo Stopping old container...\\",
                        \\"docker stop ${CONTAINER_NAME} || true\\",
        
                        \\"echo Removing old container...\\",
                        \\"docker rm ${CONTAINER_NAME} || true\\",
        
                        \\"echo Starting new container...\\",
                        \\"docker run -d --name ${CONTAINER_NAME} -p 80:80 ${IMAGE}\\"
                      ]" \
                      --output text
        
                    echo "✅ SSM command sent"
                    '''
                }
            }
        }


    }
    
}